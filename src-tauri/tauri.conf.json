{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerGauge HUD",
  "version": "0.1.0",
  "identifier": "com.powergauge.hud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PowerGauge HUD",
        "width": 1030,
        "height": 295,
        "minWidth": 180,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "PowerGauge Project",
    "category": "Utility",
    "shortDescription": "Floating System Performance Power Gauges & Desktop Telemetry Suite",
    "longDescription": "Lightweight Windows system performance monitor featuring customizable floating desktop power gauges, tear-off sensor windows, and a full desktop telemetry dashboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
