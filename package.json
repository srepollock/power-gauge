{
  "name": "power-gauge-hud",
  "private": true,
  "version": "0.1.0",
  "description": "Floating System Performance Power Gauges Desktop HUD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/utils/telemetryAdapter.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:bump": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -BundleInstallers"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
